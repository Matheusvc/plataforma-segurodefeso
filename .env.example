# Copie para .env (que NÃO vai para o GitHub) e ajuste. Em desenvolvimento nada é obrigatório.

# Banco (produção: PostgreSQL). Sem isso, usa H2 em arquivo em backend/data.
DATABASE_URL=jdbc:postgresql://localhost:5432/seguro_defeso
DATABASE_USER=seguro
DATABASE_PASSWORD=troque-esta-senha

# Pasta dos documentos anexados.
UPLOAD_FOLDER=/var/seguro_defeso/uploads

# Obrigatório em produção: frase longa e secreta que criptografa a senha gov dos clientes.
# Não troque depois, senão as senhas já salvas deixam de abrir. Guarde junto do backup.
APP_CRIPTO_CHAVE=troque-por-uma-frase-longa-e-secreta

# Produção atrás de HTTPS.
COOKIE_SEGURO=true
PORT=8080

# Primeiro administrador (só na primeira execução; remova depois do primeiro acesso).
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=

# Nunca true com dados reais.
DADOS_EXEMPLO=false
